{
  "name": "orangehrm-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio-quality OrangeHRM UI automation framework using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts --project=chromium --workers=2",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  }
}
